includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Remove once the first model with a household_id uses the trait.
        -
            identifier: trait.unused
            path: app/Models/Concerns/BelongsToHousehold.php
            count: 1
