includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Remove once the first model with an encrypted household field uses the trait.
        -
            identifier: trait.unused
            path: app/Models/Concerns/HasEncryptedFields.php
            count: 1
